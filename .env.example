VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay public key id only. Keep the key secret in Supabase Edge Function secrets.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
VITE_SITE_URL=https://your-store-domain.example

# Supabase Edge Function secrets (set with `supabase secrets set`; never prefix with VITE_):
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me
# RAZORPAY_WEBHOOK_SECRET=replace_me
# RESEND_API_KEY=re_replace_me
# STORE_FROM_EMAIL=orders@your-store-domain.example
# SITE_URL=https://your-store-domain.example
